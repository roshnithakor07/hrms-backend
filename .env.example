NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
# Hours a candidate portal link (joinee form email) works (default 24 = 1 day)
CANDIDATE_PORTAL_LINK_TTL_HOURS=24
# Comma-separated list of allowed frontend origins (empty = allow all in dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
# Swagger UI at /api/v1/docs (defaults to on unless NODE_ENV=production)
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# â”€â”€ Database â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hrms_db
DATABASE_LOGGING=false

# â”€â”€ Auth (JWT_SECRET must be at least 32 characters) â”€â”€â”€â”€
JWT_SECRET=change-me-to-a-long-random-string-32chars-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# â”€â”€ Redis (used once core/cache and core/queue are built) â”€
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# â”€â”€ File storage (documents module) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# local | s3 (any S3-compatible service: AWS, MinIO, Cloudflare R2, ...)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE=5242880
# local driver: signed URLs point at <STORAGE_LOCAL_BASE_URL>/storage/local. Leave empty for
# http://localhost:<PORT>/api/v1, or https://<NGROK_DOMAIN>/api/v1 when NGROK_ENABLED=true.
STORAGE_LOCAL_BASE_URL=
# local driver: HMAC key for signed URLs (min 32 chars); empty = derived from JWT_SECRET
STORAGE_LOCAL_SIGNING_SECRET=
# s3 driver (S3_BUCKET required when STORAGE_DRIVER=s3). Empty keys = AWS default credential chain.
S3_BUCKET=
S3_REGION=us-east-1
# Empty for AWS; e.g. http://localhost:9000 for MinIO
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO and most self-hosted S3-compatible services
S3_FORCE_PATH_STYLE=false
# Public base URL (CDN / public bucket prefix) for non-expiring profile picture URLs;
# empty = 7-day presigned URLs (S3 maximum)
S3_PUBLIC_BASE_URL=

# â”€â”€ Email (core/mail; empty SMTP_HOST = log emails instead of sending) â”€
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@hrms.local

# Gotenberg (core/pdf; HTML to PDF for the offer letter). Optional: empty = the app starts, and
# only sending an offer letter fails (503). Local dev: docker compose -f docker-compose.dev.yml up -d gotenberg
GOTENBERG_URL=http://localhost:3100
GOTENBERG_TIMEOUT_MS=30000
