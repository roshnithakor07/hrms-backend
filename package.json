{
  "name": "hrms-backend",
  "version": "0.0.1",
  "description": "HRMS (HR management system) backend skeleton - NestJS + PostgreSQL",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "tunnel": "node scripts/dev/ngrok-tunnel.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --config test/jest.config.ts",
    "test:watch": "jest --config test/jest.config.ts --watch",
    "test:cov": "jest --config test/jest.config.ts --coverage",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:generate": "npm run typeorm -- -d src/database/data-source.ts migration:generate",
    "migration:run": "npm run typeorm -- -d src/database/data-source.ts migration:run",
    "migration:revert": "npm run typeorm -- -d src/database/data-source.ts migration:revert",
    "seed:super-admin": "ts-node -r tsconfig-paths/register src/database/seeds/create-super-admin.ts",
    "seed:countries-states": "ts-node -r tsconfig-paths/register src/database/seeds/seed-countries-states.ts",
    "seed:org-masters": "ts-node -r tsconfig-paths/register src/database/seeds/seed-org-masters.ts",
    "seed:branches": "ts-node -r tsconfig-paths/register src/database/seeds/seed-branches.ts",
    "seed:offer-letter-templates": "ts-node -r tsconfig-paths/register src/database/seeds/seed-offer-letter-templates.ts",
    "seed:employees": "ts-node -r tsconfig-paths/register src/database/seeds/seed-employees.ts",
    "seed:candidates": "ts-node -r tsconfig-paths/register src/database/seeds/seed-candidates.ts",
    "seed:app-menus": "ts-node -r tsconfig-paths/register src/database/seeds/seed-app-menus.ts",
    "seed:replace-email-domain": "ts-node -r tsconfig-paths/register src/database/seeds/replace-email-domain.ts",
    "db:dev": "docker compose -f docker-compose.dev.yml up -d"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.6",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.0",
    "@ngrok/ngrok": "^1.7.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "exceljs": "4.4.0",
    "joi": "^17.13.3",
    "nestjs-i18n": "^10.8.5",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "2.18.1",
    "sharp": "^0.34.5",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.24",
    "@types/passport-jwt": "^4.0.1",
    "@types/sanitize-html": "2.16.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
